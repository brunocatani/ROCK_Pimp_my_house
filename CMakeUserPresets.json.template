// Copy to CMakeUserPresets.json (ignored by git) and set the mod folder the build deploys to.
// Build and deploy:  cmake --preset custom-fast
//                    cmake --build build-fast --config Release
// Tests:             cmake --build build-fast --config Release --target build_tests
//                    ctest --test-dir build-fast -C Release --output-on-failure
{
  "version": 3,
  "configurePresets": [
    {
      "name": "custom-fast",
      "inherits": "fast",
      "cacheVariables": {
        "POST_BUILD_COPY_PLUGIN": true,
        "COPY_PLUGIN_BASE_PATH": "[MO2 mods folder]/ROCK_Pimp_my_house"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "custom-fast",
      "configurePreset": "custom-fast",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "custom-fast",
      "configurePreset": "custom-fast",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
